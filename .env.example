# Supabase (server-side, used by the Vercel functions in /api)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM director (Gemma 4) runs in the colla_gemma Supabase edge function, which
# reads GEMINI_API_KEY / GEMINI_API_KEY_2 from Supabase secrets (not here).
# The app reaches it via SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
